# ==========================================
# NGINX REVERSE PROXY -- SAMPLE CONFIG (Phase 15D/15E)
#
# Only relevant for a self-managed VPS deployment where this Node
# process is NOT already sitting behind a managed platform's own
# TLS-terminating proxy (Render and Vercel both already provide this
# -- see the Phase 15 final report for which applies to you). If you
# use this, also set TRUST_PROXY=1 in server/.env (server/app.js) so
# the login/rate limiters see the real client IP, not nginx's.
#
# To use: copy to /etc/nginx/sites-available/zioventure, edit the
# EDIT markers below, symlink into sites-enabled, `nginx -t` to
# validate, then reload nginx. Obtain the TLS certificate separately
# (e.g. via certbot/Let's Encrypt) -- this file assumes it already
# exists at the paths referenced below.
# ==========================================

# ---- HTTP -> HTTPS redirect ----
server {
    listen 80;
    listen [::]:80;
    server_name api.zioventure.com; # EDIT: your real API domain

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- HTTPS reverse proxy to the Node backend ----
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.zioventure.com; # EDIT: your real API domain

    # EDIT: paths to your real certificate/key (e.g. from certbot)
    ssl_certificate     /etc/letsencrypt/live/api.zioventure.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.zioventure.com/privkey.pem;

    # HSTS -- only enable this AFTER confirming HTTPS is stable and
    # permanent for this domain (Part D's explicit caution: turning
    # this on prematurely, then needing to fall back to HTTP, locks
    # returning visitors' browsers out for the max-age duration).
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    client_max_body_size 55m; # a little above the app's largest multer limit (50MB meeting attachments)

    location / {
        proxy_pass http://127.0.0.1:5000; # EDIT: match server/.env's PORT
        proxy_http_version 1.1;

        # Required so the app's own JWT/session/rate-limiting logic
        # sees the real client, not nginx (server/config/securityConfig.js's
        # TRUST_PROXY, server/app.js's app.set("trust proxy", ...)).
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Socket.IO requires WebSocket upgrade support.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400; # keep long-lived Socket.IO connections open
    }
}
