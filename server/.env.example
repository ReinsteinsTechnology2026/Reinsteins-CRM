# ==========================================
# Reinsteins WorkHub / ZioVenture -- environment template (Phase 8,
# reorganized Phase 15A)
#
# Copy this file to `.env` in the same directory and fill in real
# values. Every variable below is read via process.env.* somewhere
# in server/ -- see the file each one is annotated with. Nothing in
# this file is a real secret; every value is a placeholder or a safe
# default.
#
# PRODUCTION SAFETY -- a production deployment must NEVER use:
#   - a localhost/127.0.0.1 database host (DB_HOST/PLATFORM_DB_HOST)
#   - DB_USER/PLATFORM_DB_USER=root (see Part G of the Phase 15
#     report for a least-privilege GRANT to use instead)
#   - the JWT_SECRET/TENANT_JWT_SECRET/PLATFORM_JWT_SECRET/
#     FILE_ACCESS_SECRET values from any development .env -- generate
#     four NEW, independent random secrets for production
#     (e.g. `openssl rand -base64 48` run four times)
#   - a local/dev SMTP relay (SMTP_HOST=127.0.0.1, MailDev, etc.)
#   - RAZORPAY_KEY_ID/KEY_SECRET starting with rzp_live_ -- this
#     project has not yet been authorized to enable Razorpay Live
#     Mode; TEST MODE keys (rzp_test_...) only
#   - NODE_ENV left unset or "development"
# ==========================================

# ------------------------------------------
# SERVER
# ------------------------------------------

# Port the Express/Socket.IO server listens on. Optional -- defaults
# to 5000 if unset (server/app.js).
PORT=5000

# Comma-separated list of frontend origins allowed to call this API
# and connect via Socket.IO (server/app.js). Optional -- defaults to
# the local Vite dev server ports (http://localhost:5173,
# http://localhost:5174) if unset. Set this to your real deployed
# frontend origin(s) in production, e.g.:
# CORS_ORIGINS=https://app.example.com,https://www.example.com
#
# This IS the "frontend URL" setting for this app -- there is no
# separate FRONTEND_URL variable; CORS_ORIGINS (browser cross-origin
# requests + Socket.IO) and APP_BASE_URL below (links inside outgoing
# emails) together cover every place the backend needs to know the
# frontend's real origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# NOTE: this deployment's Express "trust proxy" setting (needed so the
# login/rate limiters see the real client IP, not a reverse proxy's)
# is hardcoded directly in server/app.js -- `app.set("trust proxy", 2)`
# -- describing the real, already-deployed topology (Nginx + Cloudflare
# Tunnel, 2 hops), rather than an env var here. If this app is ever
# deployed behind a DIFFERENT reverse-proxy topology, update that line
# in app.js to match (see Express's own trust-proxy docs).

# ------------------------------------------
# LEGACY / REINSTEINS TENANT DATABASE (server/config/db.js)
# The original single-tenant MySQL connection -- still Reinsteins'
# own database (reinsteins_workhub) after the multi-tenant migration.
# ------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_USER=REQUIRED_NO_DEFAULT
DB_PASSWORD=REQUIRED_NO_DEFAULT
DB_NAME=reinsteins_workhub

# ------------------------------------------
# GROWORGS PLATFORM DATABASE
# (server/config/platformDb.js, provisioningDb.js,
#  tenantConnectionManager.js, services/tenantProvisioningService.js)
# Separate credentials for the platform-level database (companies,
# platform_users, demo_requests) and for provisioning/connecting to
# each tenant's own database.
# ------------------------------------------

PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=3306
PLATFORM_DB_USER=REQUIRED_NO_DEFAULT
PLATFORM_DB_PASSWORD=REQUIRED_NO_DEFAULT
PLATFORM_DB_NAME=groworgs_platform_db

# ------------------------------------------
# JWT SECRETS -- four independent, mutually-exclusive secrets.
# Each one MUST be a long, random, unique string in production
# (e.g. `openssl rand -base64 48`). Never reuse one secret for
# multiple purposes.
# ------------------------------------------

# Legacy Reinsteins auth (server/middleware/authMiddleware.js,
# server/controllers/authController.js, Socket.IO legacy auth in
# server/app.js).
JWT_SECRET=REQUIRED_NO_DEFAULT

# Company-aware tenant login (server/middleware/tenantAuthMiddleware.js,
# server/controllers/tenantAuthController.js, Socket.IO tenant auth
# in server/app.js).
TENANT_JWT_SECRET=REQUIRED_NO_DEFAULT

# Platform Owner auth (server/middleware/platformAuthMiddleware.js,
# server/controllers/platformAuthController.js).
PLATFORM_JWT_SECRET=REQUIRED_NO_DEFAULT

# Short-lived file-access tokens for authenticated /uploads/* serving
# (server/utils/fileAccessToken.js).
FILE_ACCESS_SECRET=REQUIRED_NO_DEFAULT

# ------------------------------------------
# RAZORPAY PAYMENT GATEWAY (Phase 11)
# (server/paymentProviders/razorpayProvider.js,
#  server/controllers/platformPaymentController.js)
#
# Optional -- if unset, every payment-gateway feature (checkout order
# creation, payment verification, webhook processing) responds with a
# clear "not configured" error and never fakes success. Nothing in
# this app requires these to be set to run.
#
# Get TEST MODE keys from the Razorpay Dashboard -> Settings -> API
# Keys (make sure "Test Mode" is toggled on, top-right of the
# dashboard) -- NEVER put Live Mode keys here until you are
# deliberately ready to process real money.
# ------------------------------------------

# Public key id -- safe to send to the frontend (Razorpay Checkout
# needs it client-side). NOT a secret by itself.
RAZORPAY_KEY_ID=

# Secret key -- server-side ONLY. Never sent to the frontend, never
# logged. Used to create orders and to verify a checkout's payment
# signature.
RAZORPAY_KEY_SECRET=

# Separate secret, configured on the Razorpay Dashboard's Webhooks
# page (Settings -> Webhooks) when you add the webhook URL. Used only
# to verify the X-Razorpay-Signature header on incoming webhook calls
# -- never sent to the frontend, never logged.
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------
# EMAIL (server/services/emailService.js)
# Optional -- if SMTP_HOST is unset, email sending silently no-ops
# (status 'skipped', never a crash) and the app runs normally with no
# email configured -- including the Phase 12 subscription lifecycle
# sweep and Phase 13 lifecycle email delivery, both of which check
# this before ever attempting a send.
#
# No separate SMTP_SECURE variable -- emailService.js auto-detects TLS
# from the port (secure = true only when SMTP_PORT is 465); most
# providers (including port 587/STARTTLS) don't need it set explicitly.
# ------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WorkHub <notifications@workhub.local>

# Base URL used to build links inside outgoing emails
# (server/services/emailTemplates.js). Optional -- defaults to
# http://localhost:5173 if unset. Set to your real deployed frontend
# origin in production.
APP_BASE_URL=http://localhost:5173

# ------------------------------------------
# NOTIFICATION SWEEP JOB (server/jobs/notificationSweep.js)
# All optional -- sensible defaults apply if unset.
# ------------------------------------------

# Set to "false" to disable the due-soon/overdue notification sweep.
NOTIFICATION_SWEEP_ENABLED=true

# How many days ahead counts as "due soon".
NOTIFICATION_DUE_SOON_DAYS=3

# How often (in milliseconds) the sweep runs.
NOTIFICATION_SWEEP_INTERVAL_MS=3600000

# ------------------------------------------
# SUBSCRIPTION LIFECYCLE (Phase 12)
# (server/config/lifecycleConfig.js, server/jobs/subscriptionLifecycleSweep.js)
# All optional -- sensible defaults apply if unset (documented here
# now; these existed since Phase 12 but were missed from this file
# until Phase 13).
# ------------------------------------------

# Set to "false" to disable the subscription lifecycle sweep (trial/
# subscription expiry, grace periods, reminders).
LIFECYCLE_SWEEP_ENABLED=true

# How often (in milliseconds) the sweep runs.
LIFECYCLE_SWEEP_INTERVAL_MS=3600000

# Comma-separated days-before-trial-ends that trigger a reminder.
TRIAL_WARNING_DAYS=3,1

# Comma-separated days-before-subscription-expires that trigger a reminder.
SUBSCRIPTION_EXPIRY_WARNING_DAYS=7,3,1

# How many days after subscription_expires_at a company keeps access
# while marked as needing renewal.
SUBSCRIPTION_GRACE_PERIOD_DAYS=5

# Comma-separated days-before-grace-period-ends that trigger a reminder.
GRACE_PERIOD_WARNING_DAYS=1

# ------------------------------------------
# EMAIL DELIVERY RETRY (Phase 13F)
# (server/config/emailConfig.js, server/services/emailDeliveryService.js)
# Optional -- sensible defaults apply if unset.
# ------------------------------------------

# Maximum number of RETRY attempts after a lifecycle email's first
# failed send (the first attempt doesn't count against this).
EMAIL_MAX_RETRIES=3

# Base delay, in minutes, before the first AUTOMATIC retry is
# eligible. Each subsequent automatic retry backs off exponentially
# (this value * 2^retryCount). A Platform Owner's manual "Retry" click
# is not subject to this delay.
EMAIL_RETRY_DELAY_MINUTES=30

# ------------------------------------------
# SECURITY HARDENING (Phase 14)
# (server/config/securityConfig.js)
# All optional -- sensible defaults apply if unset.
# ------------------------------------------

# Platform Owner account lockout: consecutive failed login attempts
# before the account is temporarily locked, and how long the lock
# lasts. Recovery is automatic once locked_until passes -- there is no
# self-service "unlock" endpoint (that would defeat the lockout).
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# Password policy, enforced server-side on every password-setting
# endpoint. Only ever applied to a NEW password -- an existing
# account's current password remains valid even if you tighten these.
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true

# Explicit JSON/form request body size limit (previously an implicit
# express default). File uploads use multer's own separate, larger
# per-route limits and are unaffected.
JSON_BODY_LIMIT=2mb

# Global API rate limit -- a generous backstop, NOT a brute-force
# control (the per-endpoint login limiters already handle that).
# Sized well above realistic legitimate portal usage.
GLOBAL_RATE_LIMIT_WINDOW_MS=300000
GLOBAL_RATE_LIMIT_MAX=600

# Stricter limit for sensitive, non-login endpoints: password change,
# 2FA setup/verify/disable, payment verification/checkout, billing
# contact changes, email retry/test-connection.
SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_RATE_LIMIT_MAX=20

# Set to "production" on a real deployment -- the global error handler
# (server/app.js) hides internal error messages/stack traces from API
# responses when this is "production", while still logging the full
# error server-side either way. Also affects Express's OWN default
# error behavior, the morgan access-log format (Phase 15O), and the
# CORS-misconfiguration startup warning (Phase 15A).
NODE_ENV=development

# ------------------------------------------
# FILE STORAGE (Phase 15J -- NOT YET IMPLEMENTED)
#
# Today, every uploaded file (chat attachments, task attachments,
# meeting recordings/attachments, profile photos) is written to the
# local filesystem at server/uploads/ (server/utils/tenantUploadPath.js)
# and served back through the authenticated /uploads/* route in
# server/app.js. This works correctly on a host with a persistent,
# writable local disk (e.g. a VPS, or Render with a persistent Disk
# add-on attached). It does NOT work on ephemeral/stateless compute
# (a bare Render web service with no attached Disk loses everything in
# server/uploads/ on every restart/redeploy; Vercel serverless
# functions have no writable persistent filesystem at all) -- see the
# Phase 15 final report, Part J, for the full risk assessment.
#
# These variables are placeholders for a FUTURE migration to object
# storage (Amazon S3 / Cloudflare R2 / Azure Blob / equivalent) and
# are not read by any code yet. Do not set them expecting a behavior
# change -- they exist only so the eventual migration has an agreed
# variable naming convention to build against.
# UPLOAD_STORAGE_DRIVER=local
# UPLOAD_STORAGE_BUCKET=
# UPLOAD_STORAGE_REGION=
# UPLOAD_STORAGE_ACCESS_KEY_ID=
# UPLOAD_STORAGE_SECRET_ACCESS_KEY=
# UPLOAD_STORAGE_ENDPOINT=
