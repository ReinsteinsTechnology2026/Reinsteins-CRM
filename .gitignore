# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment / secrets
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Build output
client/dist/
client/dist-ssr/

# Logs
logs/
*.log
server/boot_stdout.log
server/boot_stderr.log
server/boot_platform_phase.log

# Uploaded user content (not source code -- real employee/company
# files should never be committed to version control)
server/uploads/**
!server/uploads/.gitkeep

# Tool-generated artifacts (never source code)
.playwright-mcp/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archives / database dumps / key material (Phase 15C -- server.zip
# was found already committed in this repo's initial commit,
# containing a real server/.env; these patterns only prevent NEW
# copies of this mistake going forward -- they do not remove anything
# already tracked, and this file never rewrites git history on its
# own. See the Phase 15 final report for what to do about the
# existing server.zip / rotate the credentials it contained.)
*.zip
*.tar
*.tar.gz
*.pem
*.p12
*.pfx
*.key
db_backup_*.sql
*.dump.sql
backups/
